{
    "manifest_version": 3,
    "name": "PromptForge",
    "version": "2.2.1",
    "description": "Local AI-powered prompt manager with versioning and Ollama integration.",
    "permissions": [
        "storage",
        "tabs",
        "scripting",
        "contextMenus",
        "notifications",
        "downloads"
    ],
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "action": {
        "default_title": "Open PromptForge",
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    },
    "background": {
        "service_worker": "service-worker.js",
        "type": "module"
    },
    "host_permissions": [
        "http://localhost:11434/*",
        "http://127.0.0.1:11434/*",
        "https://ollama.com/*"
    ],
    "optional_host_permissions": [
        "<all_urls>"
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "icons/*",
                "icon-nocircle.svg",
                "info.html",
                "promptStorage.js",
                "utils.js",
                "llm_providers.json"
            ],
            "matches": [
                "*://chatgpt.com/*",
                "*://claude.ai/*",
                "*://gemini.google.com/*",
                "*://chat.deepseek.com/*",
                "*://grok.com/*",
                "*://copilot.microsoft.com/*",
                "*://www.perplexity.ai/*",
                "*://www.genspark.ai/*",
                "*://poe.com/*",
                "*://github.com/*",
                "*://www.kimi.com/*",
                "*://chat.mistral.ai/*",
                "*://platform.openai.com/*",
                "*://openrouter.ai/*",
                "*://aistudio.google.com/*",
                "*://lmarena.ai/*",
                "*://chat.qwen.ai/*",
                "*://notebooklm.google.com/*",
                "*://apps.abacus.ai/*"
            ]
        }
    ],
    "commands": {
        "_execute_action": {
            "suggested_key": {
                "default": "Ctrl+Shift+P",
                "mac": "Command+Shift+P"
            },
            "description": "Open PromptForge"
        }
    }
}
